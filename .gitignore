# Local dev override — exposes `web` on 5000:5000 directly. Must never
# reach the VPS: it would re-expose web publicly alongside Caddy, bypassing
# HTTPS entirely (see DEPLOY.md). Gitignored so it can't be committed by
# accident and end up deployed.
docker-compose.override.yml

