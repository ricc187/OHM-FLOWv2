# Exemple de fichier .env pour le projet OHM-FLOWv2
# Renomme ce fichier en .env une fois cloné et remplis les variables avec tes propres valeurs

# Définir l'environnement Flask (development, testing, production)
FLASK_ENV=production

# Clé secrète utilisée par le serveur (signe les cookies de session — doit être longue et sécurisée)
SECRET_KEY=TA_CLEF_SECRETE_TRES_LONGUE_ET_SECURISEE

# Clé Fernet qui chiffre les secrets TOTP (2FA) en base — distincte de SECRET_KEY.
# Optionnelle : si absente, une clé est générée et persistée dans backend/.mfa_key
# au premier démarrage. La fixer ici est plus sûr pour un redéploiement propre.
# Générer : python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
